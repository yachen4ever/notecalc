{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "notecalc",
  "version": "0.10.0",
  "identifier": "com.yachen.notecalc",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "notecalc",
        "width": 960,
        "height": 600,
        "minWidth": 640,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://gitee.com/yachen/notecalc/raw/main/updates/latest.json"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ4MUEzNzc3MjRCRDdCMTMKUldRVGU3MGtkemNhMkQxdkRrZGlPZXg0VTVRdTk5SWwyelpSUmRFOTgvS0Iya0U0cnhQaUsybmkK"
    }
  }
}
